# GrievanceIQ Pipeline — Environment Variables
# Copy this file to .env and fill in real values

# Shared secret between Cloudflare Worker and this Python service
INTERNAL_API_KEY=change-me-to-a-strong-secret

# Cloudflare D1 REST API credentials
# Find these in Cloudflare Dashboard > Workers & Pages > D1
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_D1_DATABASE_ID=your-d1-database-id
CF_D1_API_TOKEN=your-cloudflare-api-token

# data.gov.in API Key (free — register at data.gov.in)
DATAGOV_API_KEY=your-datagov-api-key
