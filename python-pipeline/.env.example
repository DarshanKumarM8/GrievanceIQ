# GrievanceIQ Pipeline — Compute Backend Environment Configuration
# Copy this file to .env and fill in your values

# Shared secret between Cloudflare Worker and Python Pipeline
INTERNAL_API_KEY=dev-internal-secret-key

# Primary Database: Supabase (Production / Hosted)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Fallback: Cloudflare D1 REST API (Optional)
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_D1_DATABASE_ID=your-d1-database-id
CF_D1_API_TOKEN=your-cloudflare-api-token

# data.gov.in API Key
DATAGOV_API_KEY=your_datagov_api_key_here
