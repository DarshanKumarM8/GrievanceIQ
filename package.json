{
  "name": "grievanceiq",
  "version": "8.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=grievanceiq-production --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name grievanceiq",
    "db:migrate:local": "wrangler d1 migrations apply grievanceiq-production --local",
    "db:seed": "wrangler d1 execute grievanceiq-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console": "wrangler d1 execute grievanceiq-production --local"
  },
  "dependencies": {
    "hono": "^4.12.5"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
