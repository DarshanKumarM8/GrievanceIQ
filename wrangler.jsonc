{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grievanceiq",
  "compatibility_date": "2026-03-08",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grievanceiq-production",
      "database_id": "local-dev-placeholder"
    }
  ],
  "triggers": {
    "crons": [
      "*/14 * * * *",
      "0 20 28 * *",
      "30 0 * * *",
      "0 21 * * *"
    ]
  },
  "vars": {
    "PIPELINE_SERVICE_URL": "http://localhost:8000"
  }
}
